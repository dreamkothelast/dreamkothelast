{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MAS Tablette",
  "version": "0.1.0",
  "identifier": "com.mastablette.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Education",
    "shortDescription": "Mini-jeux éducatifs MAS",
    "longDescription": "Suite de mini-jeux sensoriels et éducatifs pour adultes en situation de handicap. 100 % hors-ligne."
  }
}
