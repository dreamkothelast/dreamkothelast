{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MAS Tablette",
  "version": "0.1.0",
  "identifier": "com.mas-tablette.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MAS Tablette",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Education",
    "shortDescription": "Mini-jeux éducatifs MAS",
    "longDescription": "Suite de mini-jeux sensoriels et éducatifs pour adultes en situation de handicap. 100 % hors-ligne.",
    "windows": {}
  }
}
